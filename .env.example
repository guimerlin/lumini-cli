# =============================================================================
# Lumini CLI — Configuração de IA
# =============================================================================
# Copie este arquivo para .env e preencha os valores necessários.
# O arquivo .env NÃO deve ser versionado (está no .gitignore).

# Provider ativo: google | ollama | openai
AI_PROVIDER=google

# Modelo a usar (depende do provider escolhido)
# google  → gemini-2.0-flash, gemini-1.5-pro, gemini-2.5-pro ...
# ollama  → llama3.2, mistral, qwen2.5-coder ...
# openai  → gpt-4o-mini, gpt-4o ...
AI_MODEL=gemini-2.0-flash

# --- Google Gemini --------------------------------------------------------
# Obtenha sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Ollama (selfhosted) --------------------------------------------------
# Requer Ollama rodando localmente: https://ollama.com
# Para usar: AI_PROVIDER=ollama | AI_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- OpenAI-compatible ---------------------------------------------------
# Funciona com OpenAI, Groq, Together AI, LM Studio, etc.
# Para usar: AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
