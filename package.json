{
  "name": "lumini-cli",
  "version": "0.1.0",
  "description": "CLI para coletar, organizar e reutilizar componentes de código com resolução inteligente de dependências via AST.",
  "type": "module",
  "bin": {
    "lumini": "bin/lumini.js"
  },
  "scripts": {
    "dev:save": "tsx src/presentation/cli.ts save",
    "dev:add": "tsx src/presentation/cli.ts add",
    "dev:list": "tsx src/presentation/cli.ts list",
    "build": "tsc -p tsconfig.json",
    "start": "node bin/lumini.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@babel/generator": "^7.24.7",
    "@babel/parser": "^7.24.7",
    "@babel/traverse": "^7.24.7",
    "@babel/types": "^7.24.7",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.23",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
